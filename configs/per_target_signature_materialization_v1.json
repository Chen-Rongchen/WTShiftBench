{
  "stage": "per_target_signature_materialization",
  "version": 1,
  "purpose": "Materialize real per_target_signature objects from Stage 2 frozen truth inputs, providing target-by-gene deltas for axis validation.",
  "input": {
    "truth_bridge_config_path": "configs/truth_driven_bridge_hcc38_hcc1143_v1.json",
    "axis_membership_path": "reports/axis_analysis/axis_membership.tsv"
  },
  "scope": {
    "dataset_role": "primary",
    "cell_lines": [
      "HCC38",
      "HCC1143"
    ]
  },
  "filters": {
    "use_axis_members_only": true,
    "min_target_cells": 20
  },
  "aggregation": {
    "method": "mean_across_cell_lines"
  },
  "output": {
    "detailed_table_path": "reports/axis_analysis/per_target_signature_by_cell_line.tsv.gz",
    "aggregated_table_path": "reports/axis_analysis/per_target_signature.tsv.gz"
  }
}
