{
  "stage": "stage2_axis_validation_summary",
  "version": 1,
  "purpose": "汇总 Stage 2 axis enrichment 与 per-target consistency 结果，生成保守的 axis validation summary，不擅自升级 frozen final_call。",
  "input": {
    "axis_summary_path": "reports/axis_analysis/axis_summary.tsv",
    "axis_enrichment_path": "reports/axis_analysis/axis_enrichment.tsv",
    "axis_target_consistency_path": "reports/axis_analysis/axis_target_consistency.tsv"
  },
  "thresholds": {
    "enrichment_fdr_cutoff": 0.25,
    "min_recurrent_targets": 2
  },
  "output": {
    "table_path": "reports/axis_analysis/axis_validation_summary.tsv",
    "markdown_path": "reports/axis_analysis/axis_validation_summary.md"
  }
}
