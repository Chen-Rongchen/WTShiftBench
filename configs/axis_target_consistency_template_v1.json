{
  "stage": "axis_target_consistency_template",
  "version": 1,
  "purpose": "Per-target pathway-consistency audit for Stage 2 frozen axes. Requires a real per_target_signature object; scripts must not fabricate it.",
  "input": {
    "per_target_signature_path": "reports/axis_analysis/per_target_signature.tsv"
  },
  "gene_sets": {
    "collections": [
      {
        "database": "MSigDB_Hallmark",
        "gmt_path": "data/reference/gene_sets/axis_annotation/msigdb_hallmark.gmt"
      },
      {
        "database": "Reactome",
        "gmt_path": "data/reference/gene_sets/axis_annotation/reactome.gmt"
      },
      {
        "database": "GO_BP",
        "gmt_path": "data/reference/gene_sets/axis_annotation/go_bp.gmt"
      },
      {
        "database": "CORUM",
        "gmt_path": "data/reference/gene_sets/axis_annotation/corum.gmt"
      }
    ]
  },
  "analysis": {
    "top_n_per_target": 50,
    "min_genes_per_term": 3,
    "max_genes_per_term": 500,
    "min_overlap": 2
  },
  "output": {
    "table_path": "reports/axis_analysis/axis_target_consistency.tsv"
  }
}
