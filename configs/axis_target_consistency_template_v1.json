{
  "stage": "stage2_axis_target_consistency_template",
  "version": 1,
  "purpose": "为 Stage 2 frozen axis 提供 per-target pathway consistency audit 入口。该配置要求先有真实 per_target_signature 对象，不允许脚本内部伪造。",
  "input": {
    "per_target_signature_path": "reports/axis_analysis/per_target_signature.tsv"
  },
  "gene_sets": {
    "collections": [
      {
        "database": "MSigDB_Hallmark",
        "gmt_path": "data/reference/gene_sets/stage2_axis_annotation/msigdb_hallmark.gmt"
      },
      {
        "database": "Reactome",
        "gmt_path": "data/reference/gene_sets/stage2_axis_annotation/reactome.gmt"
      },
      {
        "database": "GO_BP",
        "gmt_path": "data/reference/gene_sets/stage2_axis_annotation/go_bp.gmt"
      },
      {
        "database": "CORUM",
        "gmt_path": "data/reference/gene_sets/stage2_axis_annotation/corum.gmt"
      }
    ]
  },
  "analysis": {
    "top_n_per_target": 50,
    "min_genes_per_term": 3,
    "max_genes_per_term": 500,
    "min_overlap": 2
  },
  "output": {
    "table_path": "reports/axis_analysis/axis_target_consistency.tsv"
  }
}
