{
  "schema_version": 1,
  "object_id": "wtshiftbench_sampling_aware_endpoint_v1",
  "status": "frozen_before_revised_model_scoring",
  "frozen_date": "2026-09-04",
  "amendment": "configs/revision/amendment_003_corrected_endpoint_object.json",
  "inputs": {
    "m1_target_table": "reports/revision/m1_bridge_confounding/target_level_covariates_and_corrected_shift.tsv",
    "m1_inference": "reports/revision/m1_bridge_confounding/bridge_inference_summary.tsv",
    "m1_final_manifest": "reports/revision/m1_bridge_confounding/m1_final_manifest.json",
    "base_truth_config": "configs/truth_driven_bridge_hcc38_hcc1143_v1.json",
    "depmap_primary_endpoint": "depmap/CRISPRGeneDependency.csv"
  },
  "context_roles": {
    "HCC1143": "qualified_primary_context",
    "HCC38": "sensitivity_boundary_context"
  },
  "eligibility": {
    "single_feature_only": true,
    "minimum_perturbed_cells": 20,
    "depmap_exact_model_value_required": true,
    "observed_shift_used_for_filtering": false,
    "dependency_value_used_for_filtering_other_than_missingness": false,
    "model_output_used_for_filtering": false
  },
  "primary_shift": {
    "column": "noise_corrected_shift",
    "definition": "observed_shift_mean_abs minus mean matched-size control-null shift",
    "negative_value_policy": "retain",
    "selection_basis": "estimator rationale, data efficiency and reproducibility; not revised model performance"
  },
  "sensitivity_shifts": [
    {
      "column": "equal_n_primary_shift",
      "label": "expected_equal_n_shift_depth_20"
    },
    {
      "column": "observed_shift_mean_abs",
      "label": "raw_descriptive_reference"
    }
  ],
  "endpoint": {
    "column": "depmap_gene_dependency",
    "direction": "larger_is_stronger_dependency",
    "file_semantics": "DepMap dependency probability"
  },
  "categories": {
    "rank_scope": "within_context",
    "rank_method": "average percentile rank",
    "low_quantile": 0.25,
    "high_quantile": 0.75,
    "labels": {
      "high_high": "endpoint_anchor",
      "high_low": "shift_excess",
      "low_high": "dependency_excess",
      "low_low": "low_information",
      "otherwise": "middle"
    }
  },
  "model_scoring_policy": {
    "revised_scoring_allowed_before_object_materialization": false,
    "HCC1143": "primary worked-example audit after target/gene contract validation",
    "HCC38": "sensitivity audit only; cannot rescue or redefine the endpoint object"
  }
}
