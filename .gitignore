# Drop composite figure outputs (kept locally, regenerated as needed);
# panels/ subdirectories under each Figure_*/ and Extended_Data_Figure_*/
# remain tracked.
manuscript/figures/Figure_*/Figure_*.png
manuscript/figures/Figure_*/Figure_*.pdf
manuscript/figures/Figure_*/Figure_*_source_data.tsv
manuscript/figures/Figure_*/Figure_*_panel_manifest.json
manuscript/figures/Figure_*/figure*_redesign_freeze.md
manuscript/extended_data/Extended_Data_Figure_*/Extended_Data_Figure_*.png
