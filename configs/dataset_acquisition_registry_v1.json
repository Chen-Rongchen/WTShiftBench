{
  "schema_version": "1.1",
  "outdir": "reports/dataset_acquisition",
  "local_inventory_path": "reports/dataset_acquisition/local_dataset_inventory.tsv",
  "acquisition_manifest_path": "reports/dataset_acquisition/dataset_acquisition_manifest.tsv",
  "download_plan_path": "reports/dataset_acquisition/download_plan.sh",
  "exclusion_rules": [
    {
      "category": "non-cancer cell line",
      "examples": ["RPE1", "iPSC", "fibroblast"],
      "reason": "Not eligible for cancer-dependency endpoint alignment; DepMap common-essential endpoint requires cancer-line context."
    },
    {
      "category": "gain-of-function perturbation",
      "examples": ["CRISPRa", "ORF overexpression", "cDNA rescue"],
      "reason": "Perturbation direction mismatch with LOF dependency endpoint; WTShiftBench measures loss-of-function induced shift, not gain-of-function."
    },
    {
      "category": "regulatory-element perturbation",
      "examples": ["enhancer CRISPRi", "promoter tiling", "CRE deletion"],
      "reason": "Perturbation object is not gene-level; endpoint mapping to DepMap gene dependency scores is not well-defined."
    },
    {
      "category": "infection or stimulation context",
      "examples": ["LPS stimulation", "viral infection", "cytokine treatment"],
      "reason": "Not eligible for baseline DepMap dependency alignment; endpoint confounded by external stimulus. Possible future non-baseline endpoint extension (e.g. stimulus-response subtyping) if a separate endpoint framework is defined."
    },
    {
      "category": "immune co-culture",
      "examples": ["melanoma/TIL co-culture", "tumor/immune spheroid"],
      "reason": "Endpoint is immune-evasion or immune-recognition context, not baseline DepMap cancer-dependency context."
    }
  ],
  "label_schema": {
    "n_perturbation_labels": "Total number of distinct perturbation labels (target_gene values) in the processed H5AD, including controls if they share a label.",
    "n_gene_targets": "Number of distinct gene-level targets after excluding control labels, multi-guide aggregate labels and QC labels.",
    "n_control_labels": "Number of distinct control labels (e.g. non-targeting, safe-targeting, scramble).",
    "n_scored_targets": "Number of targets that can be mapped to DepMap common-essential endpoint and receive a truth label."
  },
