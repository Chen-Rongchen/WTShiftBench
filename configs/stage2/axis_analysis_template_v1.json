{
  "stage": "stage2_axis_analysis_template",
  "version": 1,
  "purpose": "为 Stage 2 frozen axis 提供 machine-readable 分析骨架。该配置只定义 axis discovery 之后的 annotation 与 validation 入口，不允许用 enrichment 单独定义 axis。",
  "input_objects": {
    "truth_bridge_report_root": "reports/stage2_truth_driven_bridge",
    "truth_bridge_data_root": "data/processed/stage2_truth_driven_bridge",
    "axis_membership_path": "reports/stage2_truth_driven_bridge/master_atlas/shared_target_axis_membership.tsv",
    "axis_loading_path": "reports/stage2_truth_driven_bridge/master_atlas/shared_target_axis_loadings.tsv",
    "target_level_bridge_table_path": "data/processed/stage2_truth_driven_bridge/combined_target_level_bridge_table.tsv.gz",
    "axis_summary_fine_path": "reports/stage2_truth_driven_bridge/master_atlas/axis_summary_fine.tsv",
    "axis_summary_macro_path": "reports/stage2_truth_driven_bridge/master_atlas/axis_summary_macro.tsv",
    "axis_crossline_consistency_path": "reports/stage2_truth_driven_bridge/master_atlas/axis_crossline_consistency.tsv"
  },
  "analysis_scope": {
    "dataset_role": "primary",
    "cell_lines": [
      "HCC38",
      "HCC1143"
    ],
    "axis_families": [
      "canonical_backbone",
      "shift_excess",
      "context_deviation"
    ]
  },
  "required_intermediate_objects": {
    "axis_membership": {
      "required_fields": [
        "axis_id",
        "axis_family",
        "target_gene",
        "membership_weight",
        "cell_line_scope",
        "evidence_tier"
      ]
    },
    "axis_gene_signature": {
      "allowed_construction_methods": [
        "shared_real_shift_mean",
        "factor_loading_ranking"
      ],
      "required_fields": [
        "axis_id",
        "gene",
        "axis_score",
        "rank",
        "direction"
      ]
    },
    "per_target_signature": {
      "required_fields": [
        "axis_id",
        "target_gene",
        "gene",
        "score"
      ]
    }
  },
  "annotation": {
    "databases": [
      "MSigDB_Hallmark",
      "Reactome",
      "GO_BP",
      "CORUM"
    ],
    "optional_databases": [
      "KEGG_Canonical",
      "DoRothEA",
      "PROGENy"
    ],
    "output_fields": [
      "axis_id",
      "database",
      "term",
      "NES_or_effect",
      "FDR",
      "leading_edge_size"
    ]
  },
  "validation": {
    "methods": [
      "per_target_fgsea",
      "pathway_sign_consistency",
      "top_pathway_recurrence",
      "leading_edge_overlap"
    ],
    "output_fields": [
      "axis_id",
      "target_gene",
      "database",
      "term",
      "NES_or_effect",
      "sign",
      "leading_edge_size"
    ]
  },
  "final_summary": {
    "required_fields": [
      "axis_id",
      "axis_label",
      "structure_support",
      "annotation_support",
      "consistency_support",
      "external_knowledge_support",
      "final_call"
    ],
    "allowed_final_calls": [
      "supported_functional_axis",
      "supported_but_generic_collapse_axis",
      "partially_supported_axis",
      "insufficient_support"
    ]
  },
  "governance": {
    "disallowed_practices": [
      "use_enrichment_as_axis_discovery_primary_evidence",
      "rename_axis_based_on_single_target_gsea_only",
      "treat_generic_stress_as_function_specific_axis_without_structure_support",
      "modify_axis_membership_after_enrichment_results"
    ],
    "recommended_execution_order": [
      "freeze_axis_members",
      "build_axis_gene_signature",
      "run_axis_level_enrichment",
      "run_per_target_consistency_audit",
      "write_axis_summary"
    ]
  },
  "output": {
    "report_root": "reports/stage2_axis_analysis",
    "expected_tables": [
      "axis_membership.tsv",
      "axis_gene_signature.tsv",
      "axis_enrichment.tsv",
      "axis_target_consistency.tsv",
      "axis_summary.tsv"
    ]
  }
}
