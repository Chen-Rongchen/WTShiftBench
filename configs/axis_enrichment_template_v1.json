{
  "stage": "axis_enrichment_template",
  "version": 1,
  "purpose": "Minimal enrichment entry point for annotating Stage 2 frozen axes. Only local GMT collections are supported; gene sets are not downloaded automatically.",
  "input": {
    "axis_gene_signature_path": "reports/axis_analysis/axis_gene_signature.tsv",
    "axis_membership_path": "reports/axis_analysis/axis_membership.tsv"
  },
  "gene_sets": {
    "collections": [
      {
        "database": "MSigDB_Hallmark",
        "gmt_path": "data/reference/gene_sets/axis_annotation/msigdb_hallmark.gmt"
      },
      {
        "database": "Reactome",
        "gmt_path": "data/reference/gene_sets/axis_annotation/reactome.gmt"
      },
      {
        "database": "GO_BP",
        "gmt_path": "data/reference/gene_sets/axis_annotation/go_bp.gmt"
      },
      {
        "database": "CORUM",
        "gmt_path": "data/reference/gene_sets/axis_annotation/corum.gmt"
      }
    ]
  },
  "analysis": {
    "method": "ora_hypergeometric",
    "top_n_per_axis": 10,
    "min_genes_per_term": 3,
    "max_genes_per_term": 5000,
    "min_overlap": 1
  },
  "output": {
    "report_root": "reports/axis_analysis",
    "table_path": "reports/axis_analysis/axis_enrichment.tsv"
  }
}
